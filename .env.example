# AI 主播的全部钥匙和设置。服务器上放在 /etc/livehost/livehost.env（root 600，deploy/install.sh 会从本文件复制一份）。
# 只填等号右边，不加引号。【必填】不填跑不起来；【可选】不填就关掉对应功能或用默认值。钥匙只放这里，不要写进代码或文档。

# ===== 主播 =====
# 【必填】用哪个主播：app/idols/ 下的文件夹名（自带示例是 example，复制一份改成你自己的）
IDOL=
# 【可选】形象：mock（静态图）、vidu（云数字人）、live2d（本地模型）或 simli（本机 OBS 真人试播）。默认 mock
AVATAR=
# 【可选】on/off 强制在播/不在播，不填按主播配置里的时间表。install.sh 第一次装会写 ON_AIR=off，试播通过后删掉
ON_AIR=

# ===== 说话（大模型） =====
# 【可选】回复后端：openrouter（默认）或 codex（本机已登录的 Codex CLI）
MODEL_PROVIDER=
# 【MODEL_PROVIDER=openrouter 时必填】OpenRouter 钥匙
OPENROUTER_API_KEY=
# 【可选】Codex 可执行文件名或路径；不填用 PATH 中的 codex
CODEX_BIN=
# 【可选】Codex 模型，不填使用该账号可用的默认模型
CODEX_MODEL=
# 【可选】Codex 普通/长回复的超时，毫秒，默认 20000 / 45000
CODEX_TIMEOUT_MS=
CODEX_LONG_TIMEOUT_MS=

# ===== 声音（豆包语音） =====
# 【必填】火山引擎豆包语音的 API Key：火山引擎控制台 → 豆包语音 → API Key 管理
VOLC_API_KEY=
# 【必填】音色 ID：豆包语音控制台的音色列表里复制（声音复刻的音色也在那里）
DOUBAO_VOICE_ID=
# 【可选】一天最多念多少字（控制配音花费），默认 60000
TTS_DAILY_CHARS=
# 【可选】两场直播之间的电台一天最多念多少字
RADIO_DAILY_CHARS=

# ===== 形象（Vidu 数字人，AVATAR=vidu 时必填） =====
# 【AVATAR=vidu 时必填】Vidu 开放平台 API Key：platform.vidu.cn → API Keys
VIDU_KEY=
# 【AVATAR=vidu 时必填】Vidu 数字人形象 ID：在 Vidu 平台用主播立绘建好形象后复制
VIDU_AVATAR_ID=
# 【可选】Vidu 接口地址，只有走隧道时才改（见 deploy/livehost-vidu-tunnel.service）
VIDU_BASE=
# 【可选】Vidu 余额低于多少点在 /api/health 里提醒，默认 1800
VIDU_WARN_CREDITS=

# ===== Live2D（AVATAR=live2d 时使用；不需要 Vidu / RTC） =====
# 【AVATAR=live2d 时必填】同源模型路径，例如 /art/<id>/live2d/host.model3.json
# 也可在主播 config.mjs 的 avatar.live2d.model 中配置；模型需自行取得授权
LIVE2D_MODEL=
# 【可选】自行安装的浏览器运行库路径，默认都在 /vendor/live2d/
LIVE2D_CORE=
LIVE2D_PIXI=
LIVE2D_DISPLAY=
# 【可选】模型许可要求的署名，显示在舞台画面中
LIVE2D_CREDIT=

# ===== Simli（AVATAR=simli 时使用；先 npm run build:simli） =====
# 【AVATAR=simli 时必填】Simli 控制台 API keys；只保存在服务器，不交给网页
SIMLI_API_KEY=
# 【AVATAR=simli 时必填】Simli 控制台形象的 Face ID，可先用官方模板
SIMLI_FACE_ID=
# 【可选】单次手动试播的最长连接时间（秒），默认 120，范围 60–3600
SIMLI_MAX_SESSION_LENGTH=
# 【可选】无输入多久结束会话（秒），默认 60，不超过单次连接时间
SIMLI_MAX_IDLE_TIME=

# ===== 观看（火山 RTC 房间，AVATAR=vidu 时必填） =====
# 【AVATAR=vidu 时必填】火山引擎实时音视频 RTC 的 AppID：火山引擎控制台 → 实时音视频 → 应用管理
VOLC_RTC_APP_ID=
# 【AVATAR=vidu 时必填】同一个应用的 AppKey
VOLC_RTC_APP_KEY=
# 【可选】填 relay 时不用 RTC，改用服务器转发画面（延迟更高）
WATCH=

# ===== 心（主播自己的长期记忆和自主行动，可选） =====
# 【可选】Anthropic API Key：console.anthropic.com → API Keys。不填就没有“心”，主播只按聊天说话
HEART_KEY=
# 【可选】Anthropic 兼容接口的地址，用官方接口就留空
HEART_BASE_URL=
# 【可选】备用的 Anthropic 兼容中转：钥匙和地址成对填，主接口出错时改走这里
HEART_KEY_RELAY=
HEART_RELAY_URL=
# 【可选】DeepSeek API Key：platform.deepseek.com → API keys，便宜的备用模型
HEART_KEY_DS=
# 【可选】心用的模型名，不填用默认
HEART_MODEL=
# 【可选】心的文件夹和状态文件夹，install.sh 会写好 /var/lib/livehost/heart 和 /var/lib/livehost/heart-state
HEART_HOME=
HEART_STATE=
# 【可选】填 0 关掉心的上网查资料
HEART_WEB=
# 【可选】心上网查资料一天最多花多少美元，默认 20
HEART_WEB_USD=

# ===== 推特（X 官方 API，可选） =====
# 【可选】X 开发者后台 developer.x.com → 你的 App → Keys and tokens。要发推、回复就把下面 4 个都填上
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
# 【可选】同一页的 Bearer Token，只用来读推特（看新闻、搜话题）
X_BEARER_TOKEN=

# ===== 币安广场 =====
# 【可选】广场 OpenAPI 钥匙：币安广场创作者中心申请。填了才会把她写的动态发到广场（官方接口）。
# 注意：发帖脚本在 ops/ 下，读的是 /etc/livehost/square.env，这一行要写到那个文件里
SQUARE_OPENAPI_KEY=
# 【可选】把每场推出去的画面另存一份检查用，例如 /var/lib/livehost/tap/show-%t.ts（%t 换成时间，一晚几 GB，保留 3 天）
SQUARE_TAP=
# 【可选】画直播画面用的无头 Chrome 路径，默认 /opt/google/chrome/chrome
SQUARE_CHROME=
CHROMIUM_PATH=

# ===== 资讯和行情（可选） =====
# 【可选】TikHub 钥匙：tikhub.io 注册后在用户中心生成，用来看抖音等平台的热门
TIKHUB_KEY=
# 【可选】抖音 cookie 文件的路径（文件里放浏览器复制出来的 cookie），配合热门搜索用
DOUYIN_COOKIE=
# 【可选】CoinAnk 钥匙：coinank.com 开放接口申请，用来看市场行情数据
COINANK_API_KEY=
# 【可选】填 1 分别关掉：大模型 / 配音 / 新闻 / 行情（排查问题时用）
MODEL_OFF=
VOICE_OFF=
NEWS_OFF=
MARKET_OFF=

# ===== 电报群和其他（可选） =====
# 【可选】fal.ai 钥匙：fal.ai → Dashboard → Keys。没有豆包钥匙时用它做备用配音
FAL_KEY=
# 【可选】放 bot.json 的文件夹（里面是电报机器人 token、群 id、机器人自己的 id），主播在电报群里聊天用
TG_DIR=
# 【可选】接入外部 AI 世界（比如 TwinOasis）的钥匙，不用就留空
TOWN_KEY=
# 【可选】只允许这些 IP 调世界接口（那个世界服务器的出口 IP，英文逗号隔开）；留空就只认钥匙
TOWN_ALLOW=
# 【可选】直播里放歌的文件夹，默认在数据文件夹下的 songs
RADIO_SONG_DIR=

# ===== 运行 =====
# 【可选】服务端口，默认 4370（Caddy 和 ops/ 的脚本都按 4370 连）
PORT=
# 【可选】监听地址，install.sh 写 127.0.0.1（只让本机的 Caddy 连）
HOST=
# 【可选】数据文件夹，install.sh 写 /var/lib/livehost/data
DATA_DIR=

# ===== 进阶（一般不用改） =====
# 【可选】show（默认，按排期开播）或 test（强制开播、打开 /api/test/ 测试接口，只在本机试用）
MODE=
# 【可选】心的空白模板文件夹，第一次启动时复制进空的 HEART_HOME，install.sh 会写好
HEART_TEMPLATE=
# 【可选】Vidu 动作库 id（app/tools/vidu-actions.mjs 建好后会告诉你）；不填就按文字描述做动作
VIDU_ACTION_LIB=
# 【可选】主播推特账号的数字 id，填了省一次查询
X_USER_ID=
# 【可选】填 0 关掉自动回推特；多久看一次推特回复（毫秒，默认 15 分钟，按次计费）
X_REPLY=
X_REPLY_POLL_MS=
# 【可选】有 HEART_KEY_DS 时嘴默认直连 DeepSeek；填 0 改回只用 OpenRouter。MOUTH_DS 换 DeepSeek 的模型名
MOUTH_DIRECT=
MOUTH_DS=
# 【可选】心用的 DeepSeek 模型：直播时 / 白天
HEART_DS_LIVE=
HEART_DS_DAY=
# 【可选】填 0 关掉直播里的整首歌
SHOW_SONGS=
# 【可选】填 fal 强制用 fal 配音（排查豆包问题时用）
VOICE_PROVIDER=
